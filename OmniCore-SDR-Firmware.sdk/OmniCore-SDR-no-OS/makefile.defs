ifeq ($(filter %/board_monitor.o,$(OBJS)),)
OBJS += ./src/platform_xilinx/board_monitor.o
endif
ifneq ($(MAKECMDGOALS),clean)
-include ./src/platform_xilinx/board_monitor.d
endif

ifeq ($(filter %/sdr_board.o,$(OBJS)),)
OBJS += ./src/console_commands/sdr_board.o
endif
ifneq ($(MAKECMDGOALS),clean)
-include ./src/console_commands/sdr_board.d
