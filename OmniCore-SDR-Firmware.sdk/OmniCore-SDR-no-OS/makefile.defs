# Support command-line builds before SDK regenerates its managed source list.
# Once SDK discovers the source, do not add a duplicate object.
ifeq ($(filter %/ch32h417_irq.o,$(OBJS)),)
OBJS += ./src/platform_xilinx/ch32h417_irq.o
endif
ifneq ($(MAKECMDGOALS),clean)
-include ./src/platform_xilinx/ch32h417_irq.d
endif

ifeq ($(filter %/pps_monitor.o,$(OBJS)),)
OBJS += ./src/platform_xilinx/pps_monitor.o
endif
ifneq ($(MAKECMDGOALS),clean)
-include ./src/platform_xilinx/pps_monitor.d
endif

ifeq ($(filter %/board_config.o,$(OBJS)),)
OBJS += ./src/board_config.o
endif
ifneq ($(MAKECMDGOALS),clean)
-include ./src/board_config.d
endif

ifeq ($(filter %/sdr_commands.o,$(OBJS)),)
OBJS += ./src/console_commands/sdr_commands.o
endif
ifneq ($(MAKECMDGOALS),clean)
-include ./src/console_commands/sdr_commands.d
endif

ifeq ($(filter %/sdr_fir.o,$(OBJS)),)
OBJS += ./src/console_commands/sdr_fir.o
endif
ifneq ($(MAKECMDGOALS),clean)
-include ./src/console_commands/sdr_fir.d
endif

ifeq ($(filter %/sdr_clock.o,$(OBJS)),)
