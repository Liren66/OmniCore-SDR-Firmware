# ---------------------------------------------------------------------------
# Vivado: everything regenerated from the .xpr, system.bd and ip_repo
# ---------------------------------------------------------------------------
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
.Xil/
*.jou
*.log
*.str
*.backup.*
xelab.pb

# Block design output products. Keep system.bd, system.bxml, ui/,
# hdl/system_wrapper.v and every IP .xci: without the .xci files and
# system.bxml, Vivado re-migrates the IPs from system.bd and loses the clock
# association of the axi_cpu_interconnect crossbar (CRITICAL WARNING BD 41-967).
OmniCore-SDR-Firmware.srcs/sources_1/bd/*/ip/**
!OmniCore-SDR-Firmware.srcs/sources_1/bd/*/ip/**/
!OmniCore-SDR-Firmware.srcs/sources_1/bd/*/ip/**/*.xci
OmniCore-SDR-Firmware.srcs/sources_1/bd/*/ipshared/
OmniCore-SDR-Firmware.srcs/sources_1/bd/*/sim/
OmniCore-SDR-Firmware.srcs/sources_1/bd/*/synth/
OmniCore-SDR-Firmware.srcs/sources_1/bd/*/hw_handoff/
OmniCore-SDR-Firmware.srcs/sources_1/bd/*/*_ooc.xdc

# ---------------------------------------------------------------------------
# ip_repo: IP packaging leftovers (component.xml never references these)
# ---------------------------------------------------------------------------
ip_repo/**/*.xpr
ip_repo/**/*.srcs/
ip_repo/user/CH32H417_IP/managed_ip_project/
ip_repo/**/BOARD_CTRL_AXI_1.0/build/

# CH32H417_IP sub-IPs: keep only the .xci, Vivado regenerates the rest
ip_repo/**/CH32H417_IP_1.0/src/*/*
!ip_repo/**/CH32H417_IP_1.0/src/*/*.xci

# ---------------------------------------------------------------------------
# Xilinx SDK workspace
# ---------------------------------------------------------------------------
OmniCore-SDR-Firmware.sdk/.metadata/
OmniCore-SDR-Firmware.sdk/.sdk/
OmniCore-SDR-Firmware.sdk/RemoteSystemsTempFiles/
OmniCore-SDR-Firmware.sdk/webtalk/
OmniCore-SDR-Firmware.sdk/*/Debug/
OmniCore-SDR-Firmware.sdk/*/Release/
OmniCore-SDR-Firmware.sdk/*_hw_platform_*/cache/
# BSP archive output; the (empty) lib/ directory itself must exist for make
OmniCore-SDR-Firmware.sdk/*_bsp/ps7_cortexa9_0/lib/*
!OmniCore-SDR-Firmware.sdk/*_bsp/ps7_cortexa9_0/lib/.gitkeep
*.o
BOOT.bin
OmniCore-SDR-Firmware.sdk/OmniCore-SDR-no-OS/bootimage/OmniCore-SDR-FSBL.bif
